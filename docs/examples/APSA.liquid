{%- assign journal = item.publicationTitle -%}
{%- assign pages = item.pages | replace: "--", "–" | replace: "-", "–" -%}
{%- assign publisher = item.publisher | default: journal -%}
{%- assign people = item.creators | where: "creatorType", "author" -%}
{%- if people.size == 0 -%}{%- assign people = item.creators -%}{%- endif -%}
{%- capture authors -%}
{%- for p in people -%}
{%- if forloop.first -%}{{ p.lastName }}{% if p.firstName != blank %}, {{ p.firstName }}{% endif %}
{%- elsif forloop.last -%}, and {% if p.firstName != blank %}{{ p.firstName }} {% endif %}{{ p.lastName }}
{%- else -%}, {% if p.firstName != blank %}{{ p.firstName }} {% endif %}{{ p.lastName }}
{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign last_char = authors | slice: -1 -%}
{%- capture auth -%}
{%- for p in people -%}{% unless forloop.first %}{% if forloop.last %}{% if forloop.length > 2 %},{% endif %} and {% else %}, {% endif %}{% endunless %}{%- assign given = p.firstName | split: " " | first -%}{% if given != blank %}{{ given }} {% endif %}{{ p.lastName }}{%- endfor -%}
{%- endcapture -%}
{%- if people.size == 1 -%}{%- assign short_auth = people[0].lastName -%}
{%- elsif people.size == 2 -%}{%- capture short_auth -%}{{ people[0].lastName }} and {{ people[1].lastName }}{%- endcapture -%}
{%- else -%}{%- capture short_auth -%}{{ people[0].lastName }} et al.{%- endcapture -%}
{%- endif %}
